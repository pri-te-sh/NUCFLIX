{
  "name": "nucflix-firebase",
  "private": true,
  "description": "Firestore security rules, AI Cloud Functions and their emulator tests for NucFlix (iOS + Fire TV).",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-nucflix \"node --test test/rules.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project nucflix-ad6e1",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions --project demo-nucflix \"node --test test/functions.test.js\"",
    "deploy:functions": "firebase deploy --only functions --project nucflix-ad6e1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "13.35.1"
  }
}
